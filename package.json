{
  "name": "money-pilot-bi2",
  "version": "3.5.0",
  "private": true,
  "description": "Money Pilot PWA Web + Android scaffold",
  "scripts": {
    "web:serve": "http-server . -p 4173 -c-1",
    "android": "cap open android",
    "cap:sync": "cap sync android",
    "prepare:www": "node scripts/prepare-www.js",
    "android:add": "npm run prepare:www && cap add android && python3 scripts/patch-android.py",
    "android:sync": "npm run prepare:www && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "http-server": "^14.1.1"
  }
}